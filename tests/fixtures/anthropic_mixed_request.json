{
  "model": "claude-gpt-openai::gpt-5.6-sol::872000[1m]",
  "max_tokens": 4096,
  "system": [
    {"type": "text", "text": "You are the Claude Code harness."},
    {"type": "text", "text": "Keep tool IDs unchanged.", "cache_control": {"type": "ephemeral"}}
  ],
  "messages": [
    {
      "role": "user",
      "content": [
        {"type": "text", "text": "Check two cities."},
        {
          "type": "image",
          "source": {"type": "base64", "media_type": "image/png", "data": "iVBORw0KGgo="}
        }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {"type": "text", "text": "I'll check both."},
        {"type": "tool_use", "id": "call_weather", "name": "weather", "input": {"city": "Paris"}},
        {"type": "tool_use", "id": "call_clock", "name": "clock", "input": {"zone": "Europe/Paris"}}
      ]
    },
    {
      "role": "user",
      "content": [
        {"type": "tool_result", "tool_use_id": "call_weather", "content": "18 C"},
        {"type": "tool_result", "tool_use_id": "call_clock", "content": [{"type": "text", "text": "21:04"}]}
      ]
    },
    {
      "role": "assistant",
      "content": [
        {"type": "thinking", "thinking": "legacy", "signature": "anthropic-signature"},
        {"type": "text", "text": "Both calls completed."}
      ]
    },
    {"role": "user", "content": "Summarize."}
  ],
  "tools": [
    {
      "name": "weather",
      "description": "Get current weather",
      "input_schema": {
        "type": "object",
        "properties": {"city": {"type": "string"}},
        "required": ["city"],
        "additionalProperties": false
      }
    },
    {
      "name": "clock",
      "description": "Get local time",
      "input_schema": {
        "type": "object",
        "properties": {"zone": {"type": "string"}},
        "required": ["zone"],
        "additionalProperties": false
      }
    }
  ],
  "tool_choice": {"type": "auto"},
  "stream": true
}
